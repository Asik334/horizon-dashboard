# Тот же бот, что зарегистрирован в Discord Developer Portal (тот же токен,
# что вы вставили в apps/api/.env как DISCORD_BOT_TOKEN)
DISCORD_BOT_TOKEN=

# Та же база, что использует apps/api — бот и Dashboard читают/пишут одни и те же таблицы
DATABASE_URL="postgresql://horizon:horizon@localhost:5432/horizon_dashboard"

# Privileged intent "Presence Intent" в Discord Developer Portal (вкладка Bot).
# Нужен только для точного подсчёта Online-участников. Для серверов < 100
# участников не требует верификации у Discord — можно смело включать.
# Если не включён ни здесь, ни в портале — бот просто не будет получать
# presenceUpdate события, onlineCount останется приблизительным (0).
ENABLE_PRESENCE_INTENT=false

NODE_ENV=development
