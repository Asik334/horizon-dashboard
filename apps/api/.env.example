# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (та же БД, что использует существующий Horizon Bot, если применимо) ---
DATABASE_URL="postgresql://horizon:horizon@localhost:5432/horizon_dashboard"

# --- Discord OAuth2 / Bot ---
# Discord Developer Portal -> ваше приложение -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback
# Токен бота (используется для kick/ban/timeout через Discord REST API)
DISCORD_BOT_TOKEN=

# --- Auth ---
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS / Cookies ---
WEB_APP_URL=http://localhost:3000
# COOKIE_DOMAIN=.yourdomain.com   # раскомментировать в проде, если api и web на поддоменах

# --- Stripe (оплата за вход в турниры) ---
# https://dashboard.stripe.com/apikeys — используйте sk_test_... на этапе разработки
STRIPE_SECRET_KEY=
# Для локальной разработки: `stripe listen --forward-to localhost:4000/api/tournaments/webhooks/stripe`
# выведет whsec_... в терминале. В проде — Dashboard -> Developers -> Webhooks -> Add endpoint,
# URL = https://<ваш-api-домен>/api/tournaments/webhooks/stripe, событие checkout.session.completed
# (плюс checkout.session.expired и charge.refunded, см. комментарий в lib/stripe.ts).
STRIPE_WEBHOOK_SECRET=
